# Artemis configuration. Copy to `.env` and adjust.
# Every value is optional; the defaults are shown here.
# Real environment variables override this file.

# --- Main app (browser UI + WebSocket) --------------------------------
# Localhost only: Caddy on this machine serves https://artemis-v01 and proxies here.
# Use 0.0.0.0 only if you need direct LAN access without the proxy.
ARTEMIS_APP_HOST=127.0.0.1
ARTEMIS_APP_PORT=8080

# Shared access token. Every browser must send it once (pair a device by opening
# https://artemis-v01/#token=<value>, or type it into the token form).
# Empty = no authentication (the server logs a warning).
# Generate one: python3 -c "import secrets; print(secrets.token_urlsafe(24))"
ARTEMIS_ACCESS_TOKEN=
# Max simultaneous WebSocket connections; extra ones are refused (close code 1013)
ARTEMIS_MAX_CONNECTIONS=4
# Max turns (recordings or typed messages) per connection per minute
ARTEMIS_TURNS_PER_MINUTE=30
# Max size of one recording, in bytes (20 MB)
ARTEMIS_MAX_AUDIO_BYTES=20971520

# --- Speech-to-text: Whisper on OpenVINO --------------------------------
ARTEMIS_STT_HOST=127.0.0.1
ARTEMIS_STT_PORT=8083
ARTEMIS_STT_MODEL_DIR=models/whisper-large-v3-turbo-ready
# OpenVINO device: GPU.0 (Arc Pro B50), GPU.1, CPU, ...
ARTEMIS_STT_DEVICE=GPU.0
# Language code (en, es, ...). Empty = auto-detect, so you can speak English or
# Spanish and Artemis answers in the same language. Set "en" for English only
# (a little more reliable on one-word commands).
ARTEMIS_STT_LANGUAGE=
# Primes Whisper's vocabulary so it spells names correctly ("Artemis", not "Earthmas").
# Keep it a short comma-separated list of names/jargon. Full sentences leak into
# transcripts when there's background noise.
ARTEMIS_STT_INITIAL_PROMPT=Artemis, Hermes.

# --- Text-to-speech: Kokoro-82M (local, ONNX on CPU) ---------------------
ARTEMIS_TTS_HOST=127.0.0.1
ARTEMIS_TTS_PORT=8084
ARTEMIS_TTS_MODEL=models/kokoro/kokoro-v1.0.onnx
ARTEMIS_TTS_VOICES=models/kokoro/voices-v1.0.bin
# Try: af_heart, af_bella, af_nicole, af_sky, bf_emma, bf_isabella
# Full list: GET http://127.0.0.1:8084/voices
ARTEMIS_TTS_VOICE=af_heart
ARTEMIS_TTS_SPEED=1.0
ARTEMIS_TTS_LANG=en-us
# Voice for Spanish replies (each sentence is checked: Spanish -> this voice with
# Spanish pronunciation). Spanish voices: em_santa, em_alex, ef_dora. Empty = off.
ARTEMIS_TTS_VOICE_ES=em_santa
ARTEMIS_TTS_MAX_CHARS=2000

# --- Agent ----------------------------------------------------------------
# echo = placeholder that repeats you; hermes = Hermes agent (see docs/hermes.md)
ARTEMIS_AGENT_BACKEND=echo
# Echo agent only: messages containing "demo" emit a fake tool call + approval
ARTEMIS_ECHO_DEMO=false
# Hermes only: its gateway API server and the API_SERVER_KEY from ~/.hermes/.env
ARTEMIS_HERMES_URL=http://127.0.0.1:8642
ARTEMIS_HERMES_KEY=
# Hidden reasoning before answering, for voice turns only: off | low | medium | high | default
# (default = Hermes config). With Gemma 4, "off" answers ~8x sooner; see docs/hermes.md.
ARTEMIS_HERMES_REASONING=off
# Optional: replace the built-in voice instructions sent with every turn
# ARTEMIS_HERMES_INSTRUCTIONS=

# --- Hands-free (Phase 7) -------------------------------------------------
# Needs models/silero/silero_vad.onnx (see README, Models)
ARTEMIS_WAKE_WORD=artemis
ARTEMIS_FOLLOW_UP_S=8
ARTEMIS_VAD_SILENCE_MS=700

# --- Logging ------------------------------------------------------------
# text (terminal) or json (one object per line). The systemd units force json.
# ARTEMIS_LOG_FORMAT=text

# --- Overrides (normally derived from the host/port values above) --------
# ARTEMIS_STT_URL=http://127.0.0.1:8083
# ARTEMIS_TTS_URL=http://127.0.0.1:8084
