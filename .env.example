# Artemis configuration. Copy to `.env` and adjust.
# Every value is optional; the defaults are shown here.
# Real environment variables override this file.

# --- Main app (browser UI + WebSocket) --------------------------------
ARTEMIS_APP_HOST=0.0.0.0
ARTEMIS_APP_PORT=8080
# Max size of one recording, in bytes (20 MB)
ARTEMIS_MAX_AUDIO_BYTES=20971520

# --- Speech-to-text: Whisper on OpenVINO --------------------------------
ARTEMIS_STT_HOST=127.0.0.1
ARTEMIS_STT_PORT=8083
ARTEMIS_STT_MODEL_DIR=models/whisper-large-v3-turbo-ready
# OpenVINO device: GPU.0 (Arc Pro B50), GPU.1, CPU, ...
ARTEMIS_STT_DEVICE=GPU.0

# --- Text-to-speech: Kokoro-82M (local, ONNX on CPU) ---------------------
ARTEMIS_TTS_HOST=127.0.0.1
ARTEMIS_TTS_PORT=8084
ARTEMIS_TTS_MODEL=models/kokoro/kokoro-v1.0.onnx
ARTEMIS_TTS_VOICES=models/kokoro/voices-v1.0.bin
# Try: af_heart, af_bella, af_nicole, af_sky, bf_emma, bf_isabella
# Full list: GET http://127.0.0.1:8084/voices
ARTEMIS_TTS_VOICE=af_heart
ARTEMIS_TTS_SPEED=1.0
ARTEMIS_TTS_LANG=en-us
ARTEMIS_TTS_MAX_CHARS=2000

# --- Overrides (normally derived from the host/port values above) --------
# ARTEMIS_STT_URL=http://127.0.0.1:8083
# ARTEMIS_TTS_URL=http://127.0.0.1:8084
