# Artemis voice app (web UI, WebSocket, agent bridge)
# Template: scripts/artemis-services.sh fills in @BASE_DIR@ / @PORT@ and installs it.
[Unit]
Description=Artemis voice app (web UI, WebSocket, agent bridge)
PartOf=artemis-voice.target
StartLimitIntervalSec=300
StartLimitBurst=5
# The app runs without STT/TTS (it reports them in /health), so: soft ordering only.
Wants=artemis-voice-stt.service artemis-voice-tts.service
After=artemis-voice-stt.service artemis-voice-tts.service hermes-gateway.service

[Service]
Type=exec
WorkingDirectory=@BASE_DIR@
ExecStart=@BASE_DIR@/venv/bin/python -m artemis.serve app
# "started" means /health answers, so dependents and `start` wait for it.
ExecStartPost=@BASE_DIR@/scripts/wait-healthy.sh @PORT@ 45
TimeoutStartSec=60
Restart=on-failure
RestartSec=3
# Self-contained: never reach out to model hubs.
Environment=PYTHONUNBUFFERED=1 HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 HF_HUB_DISABLE_TELEMETRY=1
# One JSON object per line; journald stores and rotates them.
Environment=ARTEMIS_LOG_FORMAT=json
SyslogIdentifier=%N
NoNewPrivileges=true
ProtectSystem=full

[Install]
WantedBy=artemis-voice.target
