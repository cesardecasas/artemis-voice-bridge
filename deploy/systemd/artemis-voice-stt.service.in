# Artemis Whisper STT (OpenVINO, Arc B50)
# Template: scripts/artemis-services.sh fills in @BASE_DIR@ / @PORT@ and installs it.
[Unit]
Description=Artemis Whisper STT (OpenVINO, Arc B50)
PartOf=artemis-voice.target
StartLimitIntervalSec=300
StartLimitBurst=5


[Service]
Type=exec
WorkingDirectory=@BASE_DIR@
ExecStart=@BASE_DIR@/venv-openvino/bin/python -m artemis.serve stt
# "started" means /health answers, so dependents and `start` wait for it.
ExecStartPost=@BASE_DIR@/scripts/wait-healthy.sh @PORT@ 120
TimeoutStartSec=135
Restart=on-failure
RestartSec=3
# Self-contained: never reach out to model hubs.
Environment=PYTHONUNBUFFERED=1 HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 HF_HUB_DISABLE_TELEMETRY=1
# One JSON object per line; journald stores and rotates them.
Environment=ARTEMIS_LOG_FORMAT=json
SyslogIdentifier=%N
NoNewPrivileges=true
ProtectSystem=full

[Install]
WantedBy=artemis-voice.target
